{
  "name": "fairth",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": ["companion", "services/*"],
  "scripts": {
    "build": "bun --filter '@fairth/*' build",
    "check": "bun run test && bun run typecheck && bun run build",
    "test": "bun test services/*/src",
    "typecheck": "bun --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": { "bun": ">=1.3.10" }
}
