# Override only when testing another official Android Emulator image.
ANDROID_EMULATOR_IMAGE=us-docker.pkg.dev/android-emulator-268719/images/29-google-x64-no-metrics:30.1.2

# Host-only ports. They are never bound to the LAN by compose.yaml.
ANDROID_ADB_PORT=5555
ANDROID_GRPC_PORT=8554

# Keep large, persistent emulator data outside Unraid's docker.img.
ANDROID_DATA_PATH=/mnt/user/appdata/fairth/android-data

# This directory must contain adbkey and adbkey.pub copied from a trusted
# workstation. Keep adbkey private and set its mode to 0600.
ANDROID_ADB_KEY_DIRECTORY=/mnt/user/appdata/fairth/adb

# Optional additional emulator flags.
EMULATOR_PARAMS=-no-window -no-audio -no-boot-anim -gpu swiftshader_indirect
