# Build or select a Redroid image that includes the Google packages you are
# licensed to use. The stock image is AOSP and does not include Google Photos.
REDROID_IMAGE=localhost/fairth-redroid:11-gapps-ndk-magisk

ANDROID_DATA_PATH=/mnt/user/appdata/fairth/android-data
ANDROID_ADB_PORT=5555
ANDROID_WIDTH=1080
ANDROID_HEIGHT=2400
ANDROID_DPI=420
ANDROID_FPS=30

# Browser-based Android onboarding. Keep this service on a trusted LAN or VPN.
SETUP_BIND_ADDRESS=0.0.0.0
SETUP_PORT=6080
SETUP_PUBLIC_URL=https://unraid.local:6080/vnc.html?autoconnect=1&resize=scale
# VNC uses the first eight characters. Generate with: openssl rand -hex 4
SETUP_PASSWORD=changeit
SETUP_DATA_PATH=/mnt/user/appdata/fairth/setup

INCOMING_PATH=/mnt/user/photos-incoming
IMPORTER_DATA_PATH=/mnt/user/appdata/fairth/importer
# Unraid's conventional nobody:users identity. Change for other NAS hosts.
SERVICE_UID=99
SERVICE_GID=100
IMPORTER_HEALTH_PORT=3001
IMPORTER_POLL_INTERVAL_MS=5000
IMPORTER_STABLE_FOR_MS=15000
IMPORTER_MAX_RETRIES=8

# Generate with: openssl rand -hex 32
INGESTION_TOKEN=replace-with-a-long-random-token
INGESTION_BIND_ADDRESS=0.0.0.0
INGESTION_PORT=3000
MAX_UPLOAD_BYTES=53687091200
UPLOAD_CHUNK_BYTES=8388608
