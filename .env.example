# Fairth runs as a non-privileged application container beside a privileged
# Redroid container. The local Android image is built because Fairth cannot
# redistribute Google packages.
REDROID_IMAGE=localhost/fairth-redroid:11-gapps-ndk-magisk
FAIRTH_IMAGE=localhost/fairth:latest
FAIRTH_CONTAINER_NAME=fairth
ANDROID_CONTAINER_NAME=fairth-android
FAIRTH_NETWORK=fairth

# Docker-managed volumes need no host setup. Replace INCOMING_PATH with an
# absolute /mnt/user/... path only when incoming media must be visible on Unraid.
FAIRTH_DATA_PATH=fairth-data
ANDROID_DATA_PATH=fairth-android-data
INCOMING_PATH=fairth-incoming

ANDROID_WIDTH=1080
ANDROID_HEIGHT=2400
ANDROID_DPI=420
ANDROID_FPS=30

# The viewer grants full control of Android. Keep it on a trusted LAN or
# tailnet and never expose it through a public reverse proxy.
ANDROID_VIEWER_BIND_ADDRESS=127.0.0.1
ANDROID_VIEWER_PORT=6080
ANDROID_VIEWER_URL=http://unraid.local:6080/vnc.html?autoconnect=1&resize=scale
# Optional defense in depth for a viewer exposed directly on a trusted LAN.
# Leave unset when a private Tailscale listener supplies the access boundary.
# ANDROID_VIEWER_PASSWORD=changeit

# The canonical origin used for owner authentication and device enrollment.
PUBLIC_BASE_URL=http://unraid.local:3000
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000

# Optional. When empty, Fairth generates a persistent secret under /data.
# To manage it yourself, generate at least 32 characters.
BETTER_AUTH_SECRET=

ANDROID_WORKER_POLL_INTERVAL_MS=5000
ANDROID_WORKER_STABLE_FOR_MS=15000
ANDROID_WORKER_MAX_RETRIES=8
MAX_UPLOAD_BYTES=53687091200
UPLOAD_CHUNK_BYTES=8388608

# Optional public web routing. The launcher attaches only the Fairth application
# container to Traefik. Redroid stays on the private FAIRTH_NETWORK.
TRAEFIK_ENABLE=false
FAIRTH_HOSTNAME=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_RATE_LIMIT_AVERAGE=50
TRAEFIK_RATE_LIMIT_BURST=100
TRAEFIK_MAX_REQUEST_BODY_BYTES=16777216
