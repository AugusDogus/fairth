flowchart LR
    subgraph clients["Clients"]
        direction TB
        companion["Expo companion"]
        owner["Owner browser"]
    end

    subgraph fairth["Fairth"]
        direction TB
        uploads["Resumable uploads"] --> worker["MediaStore worker"]
        onboarding["Private onboarding"]
    end

    subgraph redroid["Private Android"]
        direction TB
        photos["Google Photos"]
        data["Persistent data"]
        photos --- data
    end

    companion -->|HTTPS| uploads
    owner -->|HTTPS| onboarding
    worker -->|private ADB| photos
    onboarding -->|private ADB| photos

    class companion,owner,uploads,worker,onboarding,photos active;
    class data supporting;
