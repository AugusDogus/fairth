#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="${CONTAINER_RUNTIME:-docker}"
container_name="${FAIRTH_CONTAINER_NAME:-fairth}"
android_container_name="${ANDROID_CONTAINER_NAME:-fairth-android}"
appliance_image="${FAIRTH_IMAGE:-localhost/fairth:latest}"
redroid_image="${REDROID_IMAGE:-localhost/fairth-redroid:11-gapps-ndk-magisk}"
network_name="${FAIRTH_NETWORK:-fairth}"
env_file="${project_dir}/.env"

usage() {
  printf '%s\n' \
    'Usage: bin/fairth-android <command>' \
    '' \
    'Commands:' \
    '  build-image  Build the local Redroid and Fairth images' \
    '  build        Build the Fairth application image' \
    '  check        Validate Docker, both images, and Redroid host support' \
    '  up           Start Redroid and Fairth on a private Docker network' \
    '  down         Remove both containers while preserving named-volume data' \
    '  status       Show both containers, web, worker, and Android readiness' \
    '  onboard      Print recent first-run and viewer logs' \
    '  shell        Open a shell inside the Android container' \
    '  reconcile    Retry automatic Android provisioning' \
    '  reboot       Reboot Android' \
    '  logs         Follow Fairth application logs' \
    '  android-logs Follow Android logs'
}

require_runtime() {
  if ! command -v "${runtime}" >/dev/null 2>&1; then
    printf 'Missing required container runtime: %s\n' "${runtime}" >&2
    return 1
  fi
  "${runtime}" info >/dev/null
}

env_value() {
  local name="$1"
  local fallback="$2"
  local value
  if [[ -f "${env_file}" ]]; then
    value="$(sed -n "s/^${name}=//p" "${env_file}" | tail -n 1 | tr -d '\r')"
  else
    value=""
  fi
  printf '%s' "${value:-${fallback}}"
}

container_name="$(env_value FAIRTH_CONTAINER_NAME "${container_name}")"
android_container_name="$(env_value ANDROID_CONTAINER_NAME "${android_container_name}")"
appliance_image="$(env_value FAIRTH_IMAGE "${appliance_image}")"
redroid_image="$(env_value REDROID_IMAGE "${redroid_image}")"
network_name="$(env_value FAIRTH_NETWORK "${network_name}")"

build_appliance() {
  require_runtime
  "${runtime}" build \
    --tag "${appliance_image}" \
    "${project_dir}"
}

check_host() {
  require_runtime
  if [[ "${runtime}" == podman ]] && [[ "$("${runtime}" info --format '{{.Host.Security.Rootless}}' 2>/dev/null || true)" == true ]]; then
    printf '%s\n' 'Redroid cannot run in rootless Podman. Use rootful Podman or Docker.' >&2
    return 1
  fi
  if [[ ! -e /dev/binder && ! -d /dev/binderfs ]] && ! grep -qw binder /proc/filesystems 2>/dev/null; then
    printf '%s\n' 'Android Binder support was not found. Configure binder_linux on the Unraid host.' >&2
    return 1
  fi
  if [[ ! -r /proc/pressure/memory ]]; then
    printf '%s\n' 'Pressure stall information is unavailable. Add psi=1 to the Unraid boot arguments, then reboot.' >&2
    return 1
  fi
  if ! "${runtime}" image inspect "${appliance_image}" >/dev/null 2>&1; then
    printf 'Fairth image is missing: %s. Run bin/fairth-android build-image.\n' "${appliance_image}" >&2
    return 1
  fi
  if ! "${runtime}" image inspect "${redroid_image}" >/dev/null 2>&1; then
    printf 'Redroid image is missing: %s. Run bin/fairth-android build-image.\n' "${redroid_image}" >&2
    return 1
  fi
  printf '%s\n' 'The host and both Fairth images are ready.'
}

start_appliance() {
  local data_path
  local android_data_path
  local incoming_path
  local web_bind
  local web_port
  local viewer_bind
  local viewer_port
  local width
  local height
  local dpi
  local fps
  local traefik_enable
  local fairth_hostname
  local traefik_network
  local network_gateway
  local system_server_state
  local boot_complete
  local boot_attempt
  local existing_name
  local provisioning_status
  local provisioning_attempt
  local -a android_arguments
  local -a fairth_arguments
  local -a provisioning_arguments

  check_host
  for existing_name in "${android_container_name}" "${container_name}"; do
    if "${runtime}" container inspect "${existing_name}" >/dev/null 2>&1; then
      printf 'Container %s already exists. Run bin/fairth-android down first.\n' "${existing_name}" >&2
      return 1
    fi
  done

  data_path="$(env_value FAIRTH_DATA_PATH fairth-data)"
  android_data_path="$(env_value ANDROID_DATA_PATH fairth-android-data)"
  incoming_path="$(env_value INCOMING_PATH fairth-incoming)"
  web_bind="$(env_value WEB_BIND_ADDRESS 0.0.0.0)"
  web_port="$(env_value WEB_PORT 3000)"
  viewer_bind="$(env_value ANDROID_VIEWER_BIND_ADDRESS 127.0.0.1)"
  viewer_port="$(env_value ANDROID_VIEWER_PORT 6080)"
  width="$(env_value ANDROID_WIDTH 1080)"
  height="$(env_value ANDROID_HEIGHT 2400)"
  dpi="$(env_value ANDROID_DPI 420)"
  fps="$(env_value ANDROID_FPS 30)"
  traefik_enable="$(env_value TRAEFIK_ENABLE false)"
  fairth_hostname="$(env_value FAIRTH_HOSTNAME '')"
  traefik_network="$(env_value TRAEFIK_NETWORK traefik)"

  if [[ "${traefik_enable}" == true ]]; then
    if [[ -z "${fairth_hostname}" ]]; then
      printf '%s\n' 'FAIRTH_HOSTNAME is required when TRAEFIK_ENABLE=true.' >&2
      return 1
    fi
    if [[ "${traefik_network}" == "${network_name}" ]]; then
      printf '%s\n' 'TRAEFIK_NETWORK must differ from FAIRTH_NETWORK so Android remains isolated.' >&2
      return 1
    fi
    if ! "${runtime}" network inspect "${traefik_network}" >/dev/null 2>&1; then
      printf 'Traefik network does not exist: %s. Create it before starting Fairth.\n' "${traefik_network}" >&2
      return 1
    fi
  fi
  if ! "${runtime}" network inspect "${network_name}" >/dev/null 2>&1; then
    "${runtime}" network create "${network_name}" >/dev/null
  fi
  network_gateway="$("${runtime}" network inspect "${network_name}" --format '{{(index .IPAM.Config 0).Gateway}}')"
  if [[ ! "${network_gateway}" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf 'The Fairth network did not provide an IPv4 gateway: %s\n' "${network_gateway}" >&2
    return 1
  fi

  android_arguments=(
    run --detach
    --name "${android_container_name}"
    --privileged
    --restart unless-stopped
    --network "${network_name}"
    --network-alias android
    # ADB stays on the bridge gateway because Android can reject direct peer traffic.
    --publish "${network_gateway}:5555:5555"
    # Android property files are boot-scoped shared memory and must start empty.
    --tmpfs /dev/__properties__
    --volume "${android_data_path}:/data"
    "${redroid_image}"
    androidboot.hardware=redroid
    "androidboot.fairth_gateway=${network_gateway}"
    "androidboot.redroid_width=${width}"
    "androidboot.redroid_height=${height}"
    "androidboot.redroid_dpi=${dpi}"
    "androidboot.redroid_fps=${fps}"
    androidboot.use_memfd=true
    ro.lmk.use_psi=true
    # Stock Unraid kernels omit tmpfs xattrs, which Android 11 data isolation requires.
    persist.zygote.app_data_isolation=false
    ro.product.cpu.abilist=x86_64,arm64-v8a,x86,armeabi-v7a
    ro.product.cpu.abilist64=x86_64,arm64-v8a
    ro.product.cpu.abilist32=x86,armeabi-v7a
    ro.dalvik.vm.isa.arm=x86
    ro.dalvik.vm.isa.arm64=x86_64
    ro.enable.native.bridge.exec=1
    ro.vendor.enable.native.bridge.exec=1
    ro.vendor.enable.native.bridge.exec64=1
    ro.dalvik.vm.native.bridge=libndk_translation.so
    ro.ndk_translation.version=0.2.3
  )

  start_android_container() {
    "${runtime}" "${android_arguments[@]}" >/dev/null

    # Redroid disables the animation, but Android 11 still waits for its completion signal.
    boot_complete=""
    for ((boot_attempt = 0; boot_attempt < 120; boot_attempt += 1)); do
      system_server_state="$("${runtime}" exec "${android_container_name}" getprop init.svc.system_server 2>/dev/null | tr -d '\r' || true)"
      if [[ "${system_server_state}" == running ]]; then
        "${runtime}" exec "${android_container_name}" setprop service.bootanim.exit 1 >/dev/null 2>&1 || true
      fi
      boot_complete="$("${runtime}" exec "${android_container_name}" getprop sys.boot_completed 2>/dev/null | tr -d '\r' || true)"
      if [[ "${boot_complete}" == 1 ]]; then break; fi
      sleep 2
    done
    if [[ "${boot_complete}" != 1 ]]; then
      printf '%s\n' 'Android did not finish booting within four minutes. Review the host kernel and Android logs.' >&2
      "${runtime}" rm --force --volumes "${android_container_name}" >/dev/null 2>&1 || true
      return 1
    fi
  }

  start_android_container

  provisioning_arguments=(
    run --rm
    --network "${network_name}"
    --volume "${data_path}:/data"
    --volume "${project_dir}/artifacts:/artifacts:ro"
  )
  if [[ -f "${env_file}" ]]; then provisioning_arguments+=(--env-file "${env_file}"); fi
  provisioning_arguments+=(
    --env "ADB_ENDPOINT=${network_gateway}:5555"
    --env PROVISIONING_STATE_DIRECTORY=/data/fairth/provisioning
    --entrypoint /usr/local/bin/fairth-provision-android
    "${appliance_image}"
  )

  provisioning_attempt=0
  while true; do
    provisioning_status=0
    "${runtime}" "${provisioning_arguments[@]}" || provisioning_status=$?
    if [[ "${provisioning_status}" -ne 75 ]]; then break; fi
    provisioning_attempt=$((provisioning_attempt + 1))
    if [[ "${provisioning_attempt}" -gt 3 ]]; then
      printf '%s\n' 'Android provisioning requested too many container recreations.' >&2
      provisioning_status=1
      break
    fi
    printf 'Recreating Android to activate provisioning changes (attempt %s of 3).\n' "${provisioning_attempt}"
    "${runtime}" rm --force --volumes "${android_container_name}" >/dev/null
    start_android_container
  done
  if [[ "${provisioning_status}" -ne 0 ]]; then
    printf 'Automatic Android provisioning failed with status %s. Android data was preserved.\n' "${provisioning_status}" >&2
    "${runtime}" rm --force --volumes "${android_container_name}" >/dev/null 2>&1 || true
    return 1
  fi

  fairth_arguments=(
    run --detach
    --name "${container_name}"
    --restart unless-stopped
    --network "${network_name}"
    --publish "${web_bind}:${web_port}:3000"
    --publish "${viewer_bind}:${viewer_port}:6080"
    --volume "${data_path}:/data"
    --volume "${incoming_path}:/incoming"
    --volume "${project_dir}/artifacts:/artifacts:ro"
  )
  if [[ "${traefik_enable}" == true ]]; then
    fairth_arguments+=(
      --label traefik.enable=true
      --label "traefik.docker.network=${traefik_network}"
      --label "traefik.http.middlewares.fairth-web-body-limit.buffering.maxRequestBodyBytes=$(env_value TRAEFIK_MAX_REQUEST_BODY_BYTES 16777216)"
      --label "traefik.http.middlewares.fairth-web-rate-limit.ratelimit.average=$(env_value TRAEFIK_RATE_LIMIT_AVERAGE 50)"
      --label "traefik.http.middlewares.fairth-web-rate-limit.ratelimit.burst=$(env_value TRAEFIK_RATE_LIMIT_BURST 100)"
      --label traefik.http.middlewares.fairth-web-rate-limit.ratelimit.period=1s
      --label "traefik.http.routers.fairth-web.entrypoints=$(env_value TRAEFIK_ENTRYPOINT websecure)"
      --label traefik.http.routers.fairth-web.middlewares=fairth-web-rate-limit@docker,fairth-web-body-limit@docker
      --label "traefik.http.routers.fairth-web.rule=Host(\`${fairth_hostname}\`)"
      --label traefik.http.routers.fairth-web.service=fairth-web
      --label traefik.http.routers.fairth-web.tls=true
      --label "traefik.http.routers.fairth-web.tls.certresolver=$(env_value TRAEFIK_CERT_RESOLVER letsencrypt)"
      --label traefik.http.services.fairth-web.loadbalancer.server.port=3000
    )
  fi
  if [[ -f "${env_file}" ]]; then fairth_arguments+=(--env-file "${env_file}"); fi
  fairth_arguments+=(
    --env "ADB_ENDPOINT=${network_gateway}:5555"
    "${appliance_image}"
  )
  if ! "${runtime}" "${fairth_arguments[@]}" >/dev/null; then
    "${runtime}" rm --force --volumes "${android_container_name}" >/dev/null 2>&1 || true
    return 1
  fi
  if [[ "${traefik_enable}" == true ]] && ! "${runtime}" network connect "${traefik_network}" "${container_name}"; then
    "${runtime}" rm --force --volumes "${container_name}" "${android_container_name}" >/dev/null 2>&1 || true
    return 1
  fi
  printf 'Fairth is starting at %s.\n' "$(env_value PUBLIC_BASE_URL "http://localhost:${web_port}")"
  printf 'Android viewer: %s\n' "$(env_value ANDROID_VIEWER_URL "http://localhost:${viewer_port}/vnc.html?autoconnect=1&resize=scale")"
}

command_name="${1:-}"
case "${command_name}" in
  build-image)
    CONTAINER_RUNTIME="${runtime}" FAIRTH_REDROID_IMAGE="${redroid_image}" "${project_dir}/bin/fairth-build-redroid"
    build_appliance
    ;;
  build)
    build_appliance
    ;;
  check)
    check_host
    ;;
  up)
    start_appliance
    ;;
  down)
    for existing_name in "${container_name}" "${android_container_name}"; do
      if "${runtime}" container inspect "${existing_name}" >/dev/null 2>&1; then
        "${runtime}" stop "${existing_name}" >/dev/null
        "${runtime}" rm --volumes "${existing_name}" >/dev/null
      fi
    done
    printf '%s\n' 'Fairth stopped. Persistent volume data was preserved.'
    ;;
  status)
    "${runtime}" ps --filter "name=^${container_name}$" --filter "name=^${android_container_name}$"
    "${runtime}" exec "${container_name}" bun -e 'for (const [name,url] of [["web","http://127.0.0.1:3000/health"],["worker","http://127.0.0.1:3001/ready"]]) { try { const response=await fetch(url); console.log(name, response.status, await response.text()); } catch (error) { console.log(name, "unreachable", error.message); } }'
    "${runtime}" exec "${android_container_name}" getprop sys.boot_completed
    ;;
  onboard)
    "${runtime}" logs --tail 80 "${container_name}"
    ;;
  shell)
    "${runtime}" exec --interactive --tty "${android_container_name}" /system/bin/sh
    ;;
  reconcile)
    "${runtime}" exec \
      --env PROVISIONING_STATE_DIRECTORY=/data/fairth/provisioning \
      "${container_name}" \
      /usr/local/bin/fairth-provision-android
    ;;
  reboot)
    "${runtime}" exec "${container_name}" /bin/bash -c 'adb connect "${ADB_ENDPOINT}" >/dev/null || true; adb -s "${ADB_ENDPOINT}" reboot'
    ;;
  logs)
    "${runtime}" logs --follow "${container_name}"
    ;;
  android-logs)
    "${runtime}" logs --follow "${android_container_name}"
    ;;
  help|-h|--help|'')
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "${command_name}" >&2
    usage >&2
    exit 2
    ;;
esac
