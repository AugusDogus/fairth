#!/usr/bin/env bash

set -euo pipefail

runtime="${CONTAINER_RUNTIME:-docker}"
redroid_script_commit="1004fc4062978c26cafe063d3fcc7357e3921c78"
redroid_script_url="https://github.com/ayasa520/redroid-script.git"
source_image="redroid/redroid:11.0.0_gapps_ndk_magisk"
output_image="${FAIRTH_REDROID_IMAGE:-localhost/fairth-redroid:11-gapps-ndk-magisk}"
build_directory="$(mktemp -d /tmp/fairth-redroid-build.XXXXXX)"
opengapps_archive='open_gapps-x86_64-11.0-mini-20220503.zip'
opengapps_md5='7669fa5c4e9579194cd354e78382a0ea'

cleanup() {
  case "${build_directory}" in
    /tmp/fairth-redroid-build.*) rm -rf -- "${build_directory}" ;;
  esac
}

trap cleanup EXIT

for command_name in git lzip python3 "${runtime}"; do
  if ! command -v "${command_name}" >/dev/null 2>&1; then
    printf 'Missing image-build dependency: %s\n' "${command_name}" >&2
    exit 1
  fi
done

if [[ "$(uname -m)" != 'x86_64' ]]; then
  printf '%s\n' 'The bundled Google Photos image build currently supports x86-64 hosts only.' >&2
  exit 1
fi

printf '%s\n' \
  'Building a local Redroid image with OpenGApps, Magisk, and ARM translation.' \
  "Pinned image-overlay builder commit: ${redroid_script_commit}"

git clone --quiet "${redroid_script_url}" "${build_directory}/redroid-script"
git -C "${build_directory}/redroid-script" checkout --quiet --detach "${redroid_script_commit}"
if [[ "$(git -C "${build_directory}/redroid-script" rev-parse HEAD)" != "${redroid_script_commit}" ]]; then
  printf '%s\n' 'The checked-out image builder does not match the pinned commit.' >&2
  exit 1
fi

gapps_source="${build_directory}/redroid-script/stuff/gapps.py"
magisk_source="${build_directory}/redroid-script/stuff/magisk.py"
sed -i \
  -e "s/open_gapps-x86_64-11.0-pico-20220503.zip/${opengapps_archive}/" \
  -e "s/5a6d242be34ad1acf92899c7732afa1b/${opengapps_md5}/" \
  -e 's|extract_to = "/tmp/ogapps/extract"|extract_to = os.environ["FAIRTH_OPENGAPPS_EXTRACT_DIR"]|' \
  "${gapps_source}"
sed -i \
  -e 's|extract_to = "/tmp/magisk_unpack"|extract_to = os.environ["FAIRTH_MAGISK_EXTRACT_DIR"]|' \
  "${magisk_source}"
if ! grep -Fq "${opengapps_archive}" "${gapps_source}" \
  || ! grep -Fq "${opengapps_md5}" "${gapps_source}" \
  || ! grep -Fq 'FAIRTH_OPENGAPPS_EXTRACT_DIR' "${gapps_source}" \
  || ! grep -Fq 'FAIRTH_MAGISK_EXTRACT_DIR' "${magisk_source}"; then
  printf '%s\n' 'The pinned Redroid builder no longer matches the expected OpenGApps or Magisk configuration.' >&2
  exit 1
fi

python3 -m venv "${build_directory}/venv"
"${build_directory}/venv/bin/pip" install --quiet --disable-pip-version-check \
  --requirement "${build_directory}/redroid-script/requirements.txt"

if [[ "${runtime}" == podman ]]; then
  sed -i 's|FROM redroid/redroid:|FROM docker.io/redroid/redroid:|' \
    "${build_directory}/redroid-script/redroid.py"
fi

(
  cd "${build_directory}/redroid-script"
  FAIRTH_OPENGAPPS_EXTRACT_DIR="${build_directory}/opengapps" \
    FAIRTH_MAGISK_EXTRACT_DIR="${build_directory}/magisk" \
    "${build_directory}/venv/bin/python" redroid.py \
    --android-version 11.0.0 \
    --install-gapps \
    --install-ndk-translation \
    --install-magisk \
    --container "${runtime}"
)

if ! "${runtime}" image inspect "${source_image}" >/dev/null 2>&1; then
  printf '%s\n' 'The image-overlay builder finished without producing its expected image.' >&2
  exit 1
fi

photos_archive="${build_directory}/opengapps/GApps/photos-x86_64.tar.lz"
photos_extract="${build_directory}/photos-extract"
photos_overlay="${build_directory}/photos-overlay"
project_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -f "${photos_archive}" ]]; then
  printf '%s\n' 'OpenGApps did not provide the expected Google Photos package.' >&2
  exit 1
fi

mkdir -p \
  "${photos_extract}" \
  "${photos_overlay}/system/app" \
  "${photos_overlay}/system/bin" \
  "${photos_overlay}/system/etc/init"
tar --lzip --extract --file "${photos_archive}" --directory "${photos_extract}"
photos_directory="$(find "${photos_extract}" -type d -path '*/app/Photos' -print -quit)"
if [[ -z "${photos_directory}" ]] \
  || [[ -z "$(find "${photos_directory}" -type f -name '*.apk' -print -quit)" ]]; then
  printf '%s\n' 'The OpenGApps Google Photos package did not contain an installable APK.' >&2
  exit 1
fi

cp -a "${photos_directory}" "${photos_overlay}/system/app/Photos"
magisk_util_functions="${build_directory}/magisk/assets/util_functions.sh"
if [[ ! -f "${magisk_util_functions}" ]]; then
  printf '%s\n' 'The Magisk package did not provide util_functions.sh.' >&2
  exit 1
fi
mkdir -p "${photos_overlay}/system/etc/init/magisk"
cp "${magisk_util_functions}" "${photos_overlay}/system/etc/init/magisk/util_functions.sh"
cp "${project_directory}/deployment/android/lmkd.rc" "${photos_overlay}/system/etc/init/lmkd.rc"
cp "${project_directory}/deployment/android/fairth-network" \
  "${photos_overlay}/system/bin/fairth-network"
chmod 0755 "${photos_overlay}/system/bin/fairth-network"
printf '%s\n' \
  "FROM ${source_image}" \
  'COPY system /system' \
  'HEALTHCHECK --interval=2s --timeout=2s --start-period=60s --retries=5 CMD ["/system/bin/fairth-network"]' \
  | "${runtime}" build --tag "${output_image}" --file - "${photos_overlay}"
printf 'Redroid image is ready: %s\n' "${output_image}"
