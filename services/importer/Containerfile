FROM docker.io/oven/bun:1.3.10-debian AS build
WORKDIR /app
COPY package.json bun.lock tsconfig.base.json ./
COPY companion/package.json ./companion/
COPY services/ingestion-api/package.json ./services/ingestion-api/
COPY services/importer/package.json services/importer/tsconfig.json ./services/importer/
RUN bun install --frozen-lockfile --filter @fairth/importer
COPY services/importer/src ./services/importer/src
RUN bun --filter @fairth/importer build

FROM docker.io/oven/bun:1.3.10-debian
RUN apt-get update \
    && apt-get install --yes --no-install-recommends adb ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/services/importer/dist ./dist
RUN mkdir -p /data /incoming && chown -R bun:bun /data /incoming
USER bun
CMD ["bun", "dist/main.js"]
