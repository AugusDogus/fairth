FROM docker.io/oven/bun:1.3.14-debian AS bun-runtime

FROM bun-runtime AS build
WORKDIR /app
COPY package.json bun.lock tsconfig.base.json ./
COPY companion/package.json ./companion/
COPY services/importer/package.json ./services/importer/
COPY services/ingestion-api/package.json services/ingestion-api/tsconfig.json services/ingestion-api/next.config.ts services/ingestion-api/postcss.config.mjs services/ingestion-api/components.json services/ingestion-api/next-env.d.ts ./services/ingestion-api/
RUN bun install --frozen-lockfile --filter @fairth/ingestion-api
COPY services/ingestion-api/src ./services/ingestion-api/src
RUN bun --filter @fairth/ingestion-api build

FROM bun-runtime
ENV NODE_ENV=production
WORKDIR /app/services/ingestion-api
COPY --from=build /app/node_modules /app/node_modules
COPY --from=build /app/services/ingestion-api/node_modules ./node_modules
COPY --from=build /app/services/ingestion-api/.next ./.next
COPY --from=build /app/services/ingestion-api/dist ./dist
COPY --from=build /app/services/ingestion-api/package.json /app/services/ingestion-api/next.config.ts ./
RUN mkdir -p /data /incoming && chown -R bun:bun /data /incoming
USER bun
CMD ["bun", "run", "start"]
