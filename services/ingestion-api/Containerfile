FROM docker.io/library/node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY services/ingestion-api/package.json services/ingestion-api/tsconfig.json ./services/ingestion-api/
RUN npm ci
COPY services/ingestion-api/src ./services/ingestion-api/src
RUN npm run build --workspace @fairth/ingestion-api

FROM docker.io/library/node:24-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/services/ingestion-api/dist ./dist
USER node
CMD ["node", "dist/main.js"]
