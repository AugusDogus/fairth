FROM docker.io/oven/bun:1.3.10-debian AS build
WORKDIR /app
COPY package.json bun.lock tsconfig.base.json ./
COPY companion/package.json ./companion/
COPY services/importer/package.json ./services/importer/
COPY services/ingestion-api/package.json services/ingestion-api/tsconfig.json ./services/ingestion-api/
RUN bun install --frozen-lockfile --filter @fairth/ingestion-api
COPY services/ingestion-api/src ./services/ingestion-api/src
RUN bun --filter @fairth/ingestion-api build

FROM docker.io/oven/bun:1.3.10-debian
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/services/ingestion-api/dist ./dist
RUN mkdir -p /data /incoming && chown -R bun:bun /data /incoming
USER bun
CMD ["bun", "dist/main.js"]
